# Telegram (via @BotFather, gratuit)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Base de donnees
TECHFLIP_DB=techflip.db

# Rythme de polling (secondes, intervalle aleatoire)
POLL_SECONDS_MIN=90
POLL_SECONDS_MAX=240
NIGHT_PAUSE=1

# Empreinte TLS. DOIT etre mobile (le client lbc envoie un UA d'app mobile).
LBC_IMPERSONATE=safari_ios

# --- Prix / tracker de composants ---
PRICEBOOK=config/pricebook.yaml
# Nb de ventes single-item avant de faire confiance au prix appris (sinon seed)
MIN_COMPARABLES=5
# Fenetre de recence des comparables (jours)
WINDOW_DAYS=90
# Part de la valeur des pieces que tu recuperes vraiment a la revente (friction)
REALIZATION_FACTOR=0.85
# Plafond de prix d'annonce a evaluer
MAX_EVAL_PRICE=1500

# --- Distance a Lille / logistique ---
EASY_KM=60
MEDIUM_KM=150
COST_PER_KM=0.25

# --- Seuils de decision (benefice net EUR) et confiance min ---
EASY_BAR=30
MEDIUM_BAR=80
HARD_BAR=120
MIN_CONF_MEDIUM=0.4
MIN_CONF_HARD=0.6

# --- IA locale (analyse photos+texte des candidats loin/incertains) ---
# API OpenAI-compatible: Ollama (laptop) OU llama-server (BC-250).
# AI_URL vide = etage IA desactive.
AI_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5vl:7b
# qwen2.5vl:7b a un contexte de 4096 tokens: 1 photo + le prompt le remplit deja.
# Ne monte au-dessus de 1 que si ton modele a un contexte plus grand.
AI_MAX_IMAGES=1
