# Telegram (via @BotFather, gratuit)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Base de donnees
TECHFLIP_DB=techflip.db
# Fichier de recherches (par defaut config/searches.yaml)
# SEARCHES_FILE=config/searches-fast.yaml

# Proxy pour tous les sites (vide = connexion directe). Peut aussi aller dans
# searches.yaml sous la cle `proxy:`.
PROXY_URL=

# Rythme de polling (secondes, intervalle aleatoire)
POLL_SECONDS_MIN=90
POLL_SECONDS_MAX=240
NIGHT_PAUSE=1

# Empreinte TLS. DOIT etre mobile (le client lbc envoie un UA d'app mobile).
# Celle qui passe DataDome change: safari_ios en juillet 2026, chrome_android
# en aout. A retester plutot que croire cette valeur.
LBC_IMPERSONATE=chrome_android

# --- Prix / tracker de composants ---
PRICEBOOK=config/pricebook.yaml
# Tes vraies ventes (prix encaisses): elles priment sur tout le reste
SOLD_PRICES=config/sold.yaml
# Nb de ventes single-item avant de faire confiance au prix appris (sinon seed)
MIN_COMPARABLES=5
# Fenetre de recence des comparables (jours)
WINDOW_DAYS=90
# Part de la valeur des pieces que tu recuperes vraiment a la revente (friction)
REALIZATION_FACTOR=0.85
# Plafond de prix d'annonce a evaluer
MAX_EVAL_PRICE=1500

# --- Distance / logistique ---
EASY_KM=60
MEDIUM_KM=150
# Cout du trajet par km (aller et retour comptes). 0.21 = 7 L/100 km a 3 EUR/L.
COST_PER_KM=0.25

# --- Seuils de decision (benefice net EUR) et confiance min ---
EASY_BAR=30
MEDIUM_BAR=80
HARD_BAR=120
MIN_CONF_MEDIUM=0.4
MIN_CONF_HARD=0.6

# --- IA locale (analyse photos+texte des candidats loin/incertains) ---
# API OpenAI-compatible: Ollama (laptop) OU llama-server (BC-250).
# AI_URL vide = etage IA desactive.
AI_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5vl:7b
# qwen2.5vl:7b a un contexte de 4096 tokens: 1 photo + le prompt le remplit deja.
# Ne monte au-dessus de 1 que si ton modele a un contexte plus grand.
AI_MAX_IMAGES=1
# L'IA ne regarde les photos que des candidats qui rapportent au moins ca (EUR):
# l'inference sur CPU est lente et chauffe la machine.
AI_MIN_MARGIN=70

# --- Point de depart du proprietaire (alertes Telegram) ---
HOME_LAT=50.6292
HOME_LNG=3.0573
HOME_LABEL=Lille

# ======================================================================
# Backend de l'app mobile (voir docs/DEPLOY.md et docs/SECURITY.md)
# ======================================================================
# Secret de signature des jetons. 48+ caracteres aleatoires:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# enforce en production. off UNIQUEMENT en local (simulateurs sans attestation).
ATTEST_MODE=enforce
# iOS App Attest: TEAMID.bundle.id + certificat racine Apple (scripts/fetch_apple_root.sh)
IOS_APP_ID=ABCDE12345.fr.techflip.app
IOS_ATTEST_ENV=production
APPLE_ROOT_CA=config/Apple_App_Attestation_Root_CA.pem
# Android Play Integrity: package + cle de compte de service GCP (role Play Integrity)
ANDROID_PACKAGE=fr.techflip.app
PLAY_SERVICE_ACCOUNT_JSON=secrets/play-integrity.json
PLAY_REQUIRE_LICENSED=1
# RevenueCat: cle SECRETE (sk_...), jamais dans l'app
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
# Valeur exacte de l'en-tete Authorization configure dans le webhook RevenueCat
REVENUECAT_WEBHOOK_AUTH=
# Optionnel: "enhanced push security" Expo
EXPO_ACCESS_TOKEN=
# Annonces plus vieilles que ca ne sont plus montrees
DEALS_MAX_AGE_DAYS=7
# Plafonds anti-aspiration par abonne
DETAIL_VIEWS_PER_DAY=400
LIST_CALLS_PER_MINUTE=60
# Annonces reverifiees par cycle (sont-elles encore en ligne ?)
DEPARTURE_CHECKS=12
# Tableau d'achat: les annonces encore en ligne apres ce nombre de jours ne
# comptent plus dans ses medianes (elles ne se sont pas vendues a ce prix)
STALE_DAYS=10
