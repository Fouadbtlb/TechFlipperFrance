# Copy to .env.local. These are PUBLIC build settings; never put a secret here.
EXPO_PUBLIC_API_URL=https://api.techflip.fr
EXPO_PUBLIC_IOS_BUNDLE_ID=fr.techflip.app
EXPO_PUBLIC_ANDROID_PACKAGE=fr.techflip.app
# RevenueCat PUBLIC SDK keys (appl_... / goog_...). The secret sk_ key lives on the server only.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Google Cloud project NUMBER linked to Play Integrity in the Play Console.
EXPO_PUBLIC_PLAY_CLOUD_PROJECT=
EXPO_PUBLIC_ANDROID_MAPS_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
# production | development (development only for Xcode debug builds)
EXPO_PUBLIC_APP_ATTEST_ENV=production
# 1 ONLY for simulator work against a local backend with ATTEST_MODE=off
EXPO_PUBLIC_INSECURE_DEV_AUTH=0
